<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de Palestras - Login</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1>Gestão de Palestras</h1>
        <nav>
            <a href="/">Início</a>
            <a href="/palestras">Palestras</a>
            <a href="/login">Login</a>
        </nav>
    </header>
    <main>
        <section class="login">
            <h2>Acessar Conta</h2>
            <% if (locals.error) { %>
                <p class="erro" role="alert"><%= locals.error %></p>
            <% } %>
            <form action="/login" method="POST">
                <div>
                    <label for="email">E-mail:</label>
                    <input 
                        type="email" 
                        id="email" 
                        name="email" 
                        value="<%= locals.email || '' %>" 
                        autocomplete="email" 
                        required
                    >
                </div>
                <div>
                    <label for="senha">Senha:</label>
                    <input 
                        type="password" 
                        id="senha" 
                        name="senha" 
                        autocomplete="current-password" 
                        required
                    >
                </div>
                <button type="submit" class="botao">Entrar</button>
            </form>
        </section>
    </main>
</body>
</html>
